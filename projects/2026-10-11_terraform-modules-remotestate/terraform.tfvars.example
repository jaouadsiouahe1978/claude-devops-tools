# AWS Configuration
aws_region = "eu-west-1"

# Project Details
project_name = "MyProject"
environment  = "dev"

# VPC Configuration
vpc_cidr = "10.0.0.0/16"

public_subnets = [
  "10.0.1.0/24",
  "10.0.2.0/24",
  "10.0.3.0/24"
]

private_subnets = [
  "10.0.10.0/24",
  "10.0.11.0/24",
  "10.0.12.0/24"
]

availability_zones = [
  "eu-west-1a",
  "eu-west-1b",
  "eu-west-1c"
]

enable_nat = true

# Security Configuration
allowed_web_cidrs = [
  "0.0.0.0/0"  # Production: restrict to specific IPs
]

allowed_ssh_cidrs = [
  "0.0.0.0/0"  # Production: restrict to specific IPs (e.g., your office)
]

app_port = 8080
