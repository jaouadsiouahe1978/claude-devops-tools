# 🚀 Nginx optimisé avec multi-stage
# Taille: ~25MB (87% de réduction)

# ============ STAGE 1: BUILD ============
FROM debian:bullseye-slim AS builder

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    curl \
    ca-certificates \
    libpcre3-dev \
    libssl-dev \
    zlib1g-dev

WORKDIR /build

# Download Nginx source
RUN curl -fsSL http://nginx.org/download/nginx-1.26.0.tar.gz | tar xz && \
    cd nginx-1.26.0

WORKDIR /build/nginx-1.26.0

# Compilation avec modules essentiels seulement
RUN ./configure \
    --prefix=/etc/nginx \
    --sbin-path=/usr/sbin/nginx \
    --modules-path=/usr/lib64/nginx/modules \
    --conf-path=/etc/nginx/nginx.conf \
    --with-http_ssl_module \
    --with-http_gzip_static_module \
    --with-http_realip_module \
    --with-stream && \
    make && \
    make install

# ============ STAGE 2: RUNTIME ============
FROM alpine:3.18

RUN apk add --no-cache \
    ca-certificates \
    curl \
    openssl \
    libpcre3

# Création d'un utilisateur non-root
RUN addgroup -g 101 -S nginx && \
    adduser -S -D -H -u 101 -h /var/cache/nginx -s /sbin/nologin -c nginx -G nginx nginx

# Copie du binaire nginx compilé
COPY --from=builder /usr/sbin/nginx /usr/sbin/nginx
COPY --from=builder /etc/nginx /etc/nginx

# Copie de la config Nginx
COPY nginx.conf /etc/nginx/nginx.conf

# Création des répertoires nécessaires
RUN mkdir -p /var/cache/nginx /var/log/nginx && \
    chown -R nginx:nginx /var/cache/nginx /var/log/nginx /etc/nginx

# Changement vers l'utilisateur non-root
USER nginx

# Health check
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
    CMD curl -f http://localhost/health || exit 1

EXPOSE 80 443

CMD ["nginx", "-g", "daemon off;"]
