<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ ansible_hostname }} - Nginx Cluster</title>
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
        }
        .container {
            background: white;
            padding: 40px;
            border-radius: 10px;
            box-shadow: 0 10px 40px rgba(0,0,0,0.3);
            max-width: 600px;
            text-align: center;
        }
        h1 {
            color: #333;
            margin-bottom: 20px;
            font-size: 2.5em;
        }
        .server-badge {
            display: inline-block;
            background: #667eea;
            color: white;
            padding: 10px 20px;
            border-radius: 5px;
            font-weight: bold;
            font-size: 1.2em;
            margin: 10px 0;
        }
        .info-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 20px;
            margin: 30px 0;
            text-align: left;
        }
        .info-item {
            background: #f5f5f5;
            padding: 15px;
            border-radius: 5px;
            border-left: 4px solid #667eea;
        }
        .info-label {
            color: #666;
            font-size: 0.9em;
            font-weight: bold;
            text-transform: uppercase;
        }
        .info-value {
            color: #333;
            font-size: 1.1em;
            margin-top: 5px;
            font-family: 'Courier New', monospace;
        }
        .status-ok {
            color: #27ae60;
            font-weight: bold;
            font-size: 1.2em;
        }
        .footer {
            margin-top: 30px;
            color: #999;
            font-size: 0.9em;
        }
        .badge-cluster {
            display: inline-block;
            background: #2ecc71;
            color: white;
            padding: 5px 10px;
            border-radius: 3px;
            margin-left: 10px;
            font-size: 0.8em;
        }
    </style>
</head>
<body>
    <div class="container">
        <h1>🚀 Welcome to Nginx Cluster</h1>
        <div class="server-badge">
            {{ ansible_hostname }}
            <span class="badge-cluster">PRODUCTION</span>
        </div>

        <div class="info-grid">
            <div class="info-item">
                <div class="info-label">Hostname</div>
                <div class="info-value">{{ ansible_hostname }}</div>
            </div>
            <div class="info-item">
                <div class="info-label">IP Address</div>
                <div class="info-value">{{ ansible_host }}</div>
            </div>
            <div class="info-item">
                <div class="info-label">Status</div>
                <div class="info-value status-ok">✅ Running</div>
            </div>
            <div class="info-item">
                <div class="info-label">Environment</div>
                <div class="info-value">{{ environment_name }}</div>
            </div>
        </div>

        <div style="background: #f0f7ff; padding: 20px; border-radius: 5px; margin: 20px 0;">
            <p><strong>🎯 Nginx Configuration</strong></p>
            <p style="margin-top: 10px; color: #555;">
                This server was configured automatically using <strong>Ansible</strong>.<br>
                Port: <code>{{ nginx_port }}</code> |
                Workers: <code>{{ nginx_worker_processes }}</code>
            </p>
        </div>

        <div class="footer">
            <p>Managed by Ansible | Last deployed: {{ ansible_date_time.iso8601 }}</p>
            <p><a href="/status" style="color: #667eea; text-decoration: none;">📊 View Status</a></p>
        </div>
    </div>
</body>
</html>
