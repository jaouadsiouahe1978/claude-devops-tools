# Production Environment Configuration
# Used by GitHub Actions deploy-prod.yml workflow

# Application
NODE_ENV=production
LOG_LEVEL=warn
DEBUG=

# Deployment
DEPLOYMENT_URL=https://app.example.com
API_ENDPOINT=https://api.example.com
DEPLOYMENT_HOST=prod-server.example.com
DEPLOYMENT_PORT=22
DEPLOYMENT_USER=deploy

# Database
DB_HOST=db-prod.example.com
DB_PORT=5432
DB_NAME=devops_production
DB_USER=app_user
DB_POOL_SIZE=50
DB_SSL=true
DB_REPLICATION_ENABLED=true

# Cache
REDIS_URL=redis://redis-prod.example.com:6379/0
REDIS_CLUSTER_ENABLED=true
REDIS_TTL=86400

# Monitoring
MONITORING_ENABLED=true
METRICS_PORT=9090
PROMETHEUS_PUSHGATEWAY=http://prometheus-prod.example.com:9091
ALERTING_ENABLED=true
ALERT_EMAIL=ops-team@example.com

# Security
TLS_ENABLED=true
TLS_CERT_PATH=/etc/ssl/certs/app.crt
TLS_KEY_PATH=/etc/ssl/private/app.key
CSRF_PROTECTION=true
RATE_LIMIT=50000

# Features
FEATURE_FLAGS=stable_only
CORS_ORIGINS=https://app.example.com,https://www.example.com
SESSION_TIMEOUT=3600
