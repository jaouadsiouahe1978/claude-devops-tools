# Staging Environment Configuration
# Used by GitHub Actions deploy-staging.yml workflow

# Application
NODE_ENV=staging
LOG_LEVEL=info
DEBUG=app:*

# Deployment
DEPLOYMENT_URL=https://app-staging.example.com
API_ENDPOINT=https://api-staging.example.com
DEPLOYMENT_HOST=staging-server.example.com
DEPLOYMENT_PORT=22
DEPLOYMENT_USER=deploy

# Database
DB_HOST=db-staging.example.com
DB_PORT=5432
DB_NAME=devops_staging
DB_USER=app_user
DB_POOL_SIZE=20

# Cache
REDIS_URL=redis://redis-staging.example.com:6379/0
REDIS_TTL=7200

# Monitoring
MONITORING_ENABLED=true
METRICS_PORT=9090
PROMETHEUS_PUSHGATEWAY=http://prometheus-staging.example.com:9091

# Features
FEATURE_FLAGS=new_ui,api_v2,analytics
CORS_ORIGINS=https://app-staging.example.com,https://admin-staging.example.com
RATE_LIMIT=5000
