# Development Environment Configuration
# Used by GitHub Actions deploy-dev.yml workflow

# Application
NODE_ENV=development
LOG_LEVEL=debug
DEBUG=*

# Deployment
DEPLOYMENT_URL=https://app-dev.example.com
API_ENDPOINT=https://api-dev.example.com
DEPLOYMENT_HOST=dev-server.example.com
DEPLOYMENT_PORT=22
DEPLOYMENT_USER=deploy

# Database
DB_HOST=db-dev.example.com
DB_PORT=5432
DB_NAME=devops_dev
DB_USER=app_user
DB_POOL_SIZE=10

# Cache
REDIS_URL=redis://redis-dev.example.com:6379/0
REDIS_TTL=3600

# Monitoring
MONITORING_ENABLED=true
METRICS_PORT=9090
PROMETHEUS_PUSHGATEWAY=http://prometheus-dev.example.com:9091

# Features
FEATURE_FLAGS=dev_feature_a,dev_feature_b
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
RATE_LIMIT=1000
