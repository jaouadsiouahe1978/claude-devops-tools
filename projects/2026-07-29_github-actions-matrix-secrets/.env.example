# GitHub Actions Environment Variables Example
# Copy to .env and fill with your values

# Application Environment
ENVIRONMENT=development
DEBUG=false

# Docker Registry
REGISTRY=docker.io
DOCKER_USERNAME=your-username
DOCKER_PASSWORD=your-password

# Deployment Settings
DEPLOY_ENDPOINT=https://api.example.com
API_GATEWAY=https://gateway.example.com

# Secrets (DO NOT COMMIT THESE)
API_KEY=your-api-key-here
DEPLOY_TOKEN=your-deploy-token-here
SLACK_WEBHOOK=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# Database (for migrations)
DB_HOST=db.example.com
DB_USER=dbuser
DB_PASSWORD=dbpass
