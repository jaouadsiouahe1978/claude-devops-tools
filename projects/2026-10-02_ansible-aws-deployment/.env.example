# Example environment configuration for Ansible deployment

# Application
APP_VERSION=1.0.0
DEBUG=false
LOG_LEVEL=INFO

# Database (if used)
DATABASE_URL=postgresql://user:pass@db.example.com/webapp
DATABASE_POOL_SIZE=20

# Cache (Redis)
REDIS_URL=redis://cache.example.com:6379/0
CACHE_TTL=3600

# AWS (if using AWS resources)
AWS_REGION=eu-west-1
AWS_ACCESS_KEY_ID=your-key-here
AWS_SECRET_ACCESS_KEY=your-secret-here

# Nginx
NGINX_PORT=80
NGINX_WORKERS=auto
NGINX_WORKER_CONNECTIONS=1024

# Application Configuration
APP_PORT=8000
APP_WORKERS=4
APP_WSGI=app:app

# Monitoring
MONITORING_ENABLED=true
METRICS_PORT=9090

# Ansible
ANSIBLE_USER=ec2-user
ANSIBLE_SSH_KEY_FILE=~/.ssh/aws.pem
