# Redis Configuration File

# Accept connections only from localhost
bind 127.0.0.1 ::1
protected-mode yes

# Port
port 6379

# TCP listen backlog
tcp-backlog 511

# TCP keepalive
tcp-keepalive 300

# Daemonize
daemonize no

# PID file
pidfile /var/run/redis.pid

# Logging
loglevel notice
logfile /var/log/redis/redis.log

# Databases
databases 16

# Persistence - RDB
save 900 1
save 300 10
save 60 10000

rdbcompression yes
rdbchecksum yes
dbfilename dump.rdb
dir /var/lib/redis

# Replication
slave-read-only yes

# Security
requirepass ""

# Clients
maxclients 10000

# Memory management
maxmemory 256mb
maxmemory-policy allkeys-lru

# Eviction policies: noeviction, allkeys-lru, volatile-lru, allkeys-random, volatile-random, volatile-ttl

# Append Only File (AOF)
appendonly no
appendfilename "appendonly.aof"
appendfsync everysec

# Lua scripting
lua-time-limit 5000

# Slow log
slowlog-log-slower-than 10000
slowlog-max-len 128

# Monitoring
latency-monitor-threshold 0

# Event notification
notify-keyspace-events ""

# Advanced config
hash-max-ziplist-entries 512
hash-max-ziplist-value 64
list-max-ziplist-size -2
list-compress-depth 0
set-max-intset-entries 512
zset-max-ziplist-entries 128
zset-max-ziplist-value 64

# Cluster
cluster-enabled no

# Performance
activerehashing yes
