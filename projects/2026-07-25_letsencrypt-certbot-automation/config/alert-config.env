# Alert Configuration for SSL Certificate Monitoring

# Email settings for certificate expiry alerts
# Leave empty to disable email alerts
EMAIL_TO=admin@example.com

# Slack webhook URL for notifications
# Generate at: https://api.slack.com/messaging/webhooks
# Leave empty to disable Slack alerts
SLACK_WEBHOOK_URL=

# Alert threshold in days (alert when cert expires within N days)
ALERT_DAYS=30

# Renewal interval in seconds (how often to check for renewals)
# 86400 = 1 day
RENEWAL_INTERVAL=86400

# Certificate check interval in seconds (how often to check expiry)
# 3600 = 1 hour
CHECK_INTERVAL=3600
