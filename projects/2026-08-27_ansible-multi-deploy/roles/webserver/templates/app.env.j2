# Application Environment Variables
# Généré automatiquement par Ansible
# À adapter selon l'application

NODE_ENV=production
APP_NAME={{ app_name | default('app') }}
APP_PORT={{ app_port | default(3000) }}
APP_VERSION={{ app_version | default('1.0.0') }}
LOG_LEVEL=info

# Database
DATABASE_URL=postgresql://{{ db_user }}:{{ db_password }}@{{ db_host }}:{{ db_port }}/{{ db_name }}

# API Configuration
API_TIMEOUT=30000
API_RETRY=3

# Security
JWT_SECRET={{ jwt_secret | default('change-me-in-vault') }}
API_KEY={{ api_key | default('change-me-in-vault') }}

# Features flags
ENABLE_CACHE=true
ENABLE_MONITORING=true
