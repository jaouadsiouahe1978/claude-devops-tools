[Unit]
Description=Envoi des candidatures validées
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/candidatures
EnvironmentFile=%h/.config/candidatures.env
ExecStart=/usr/bin/python3 %h/candidatures/candidatures.py send --confirm
# durcissement
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=%h/candidatures/data
