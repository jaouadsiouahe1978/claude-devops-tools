global:
  scrape_interval: {{ prometheus_scrape_interval }}
  evaluation_interval: {{ prometheus_evaluation_interval }}
  external_labels:
    environment: {{ env }}
    cluster: production

alerting:
  alertmanagers:
    - static_configs:
        - targets: []

rule_files:
  - /etc/prometheus/rules.yml

scrape_configs:
  # Prometheus lui-même
  - job_name: 'prometheus'
    static_configs:
      - targets: ['localhost:9090']

  # Node Exporter - métriques système
  - job_name: 'node'
    relabel_configs:
      - source_labels: [__address__]
        target_label: instance
    static_configs:
      {% for host in groups['all'] %}
      - targets: ['{{ hostvars[host]['ansible_host'] }}:9100']
        labels:
          server: {{ host }}
      {% endfor %}

  # Nginx - métriques web
  - job_name: 'nginx'
    metrics_path: '/nginx_status'
    static_configs:
      {% for host in groups['webservers'] %}
      - targets: ['{{ hostvars[host]['ansible_host'] }}:80']
        labels:
          server: {{ host }}
      {% endfor %}

  # PostgreSQL - métriques DB
  - job_name: 'postgresql'
    static_configs:
      {% for host in groups['dbservers'] %}
      - targets: ['{{ hostvars[host]['ansible_host'] }}:5432']
        labels:
          server: {{ host }}
      {% endfor %}
