#jinja2: lstrip_blocks: "True", trim_blocks: "True"
global
    log /dev/log local0
    log /dev/log local1 notice
    chroot {{ haproxy_chroot }}
    stats socket /run/haproxy/admin.sock mode 660 level admin
    stats timeout 30s
    user haproxy
    group haproxy
    daemon

    # performance tuning
    maxconn {{ haproxy_maxconn }}

    # SSL/TLS defaults
    tune.ssl.default-dh-param 2048
    ssl-default-bind-ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256
    ssl-default-bind-options ssl-min-ver TLSv1.2

defaults
    log     global
    mode    http
    option  httplog
    option  dontlognull
    option  http-server-close
    timeout connect 5000
    timeout client  50000
    timeout server  50000
    timeout tunnel  50000

    # error pages
    errorfile 400 /etc/haproxy/errors/400.http
    errorfile 403 /etc/haproxy/errors/403.http
    errorfile 408 /etc/haproxy/errors/408.http
    errorfile 500 /etc/haproxy/errors/500.http
    errorfile 502 /etc/haproxy/errors/502.http
    errorfile 503 /etc/haproxy/errors/503.http
    errorfile 504 /etc/haproxy/errors/504.http

# Stats interface
listen stats
    bind 0.0.0.0:{{ haproxy_stats_port }}
    stats enable
    stats uri {{ haproxy_stats_uri }}
    stats realm "HAProxy Stats"
    stats auth {{ haproxy_stats_user }}:{{ haproxy_stats_password }}
    stats refresh 30s
    stats admin if TRUE

# HTTP Frontend
frontend frontend_http
    bind 0.0.0.0:{{ haproxy_port }}
    mode http
    option httplog
    option forwardfor
    option http-server-close

    # Set X-Forwarded headers
    http-request set-header X-Forwarded-For %[src]
    http-request set-header X-Forwarded-Proto http
    http-request set-header X-Forwarded-Port %[dst_port]

    # ACL definitions
    acl is_health_check path /health

    # Routing rules
    use_backend backend_health if is_health_check
    default_backend backend_servers

# Health check backend
backend backend_health
    mode http
    stats uri /
    stats enable
    stats admin if TRUE

# Application backend servers
backend backend_servers
    mode http
    balance {{ haproxy_algorithm }}
    option forwardfor
    option http-server-close
    option httpchk GET /health HTTP/1.1\r\nHost:\ localhost

    # Connection options
    default-server inter {{ haproxy_health_check.interval }} timeout {{ haproxy_health_check.timeout }} rise {{ haproxy_health_check.rise }} fall {{ haproxy_health_check.fall }}

    # Backend servers
    {% for server in haproxy_backend_servers %}
    server {{ server.name }} {{ server.host }}:{{ server.port }} check
    {% endfor %}

    # Session persistence (optional)
    # cookie SERVERID insert indirect nocache
